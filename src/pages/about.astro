---
import PageContainer from "../components/PageContainer.astro";
import BasePageLayout from "../layouts/BasePageLayout.astro";
---

<BasePageLayout title="About">
    <PageContainer>
        <h1 id="about-title">About Me</h1>
        <div id="about-card">
            <p>
                In my free time, I love having fun with software development, as
                well as the occasional mountain bike ride. I spend the vast
                majority of my time these days with my Formula student team,
                writing firmware, working on various electrical things, and
                doing embedded code review :)
            </p>
        </div>
    </PageContainer>
</BasePageLayout>
<style>
    #about-title {
        margin: 0 10px;
        /* text-shadow: 2px 4px 9px rgba(0,0,0,0.4); */
    }
    #about-card {
        padding: 15px;
        margin: 20px 0px;
        background-color: var(--bg2);
        border-radius: 10px;
        box-shadow: rgba(0, 0, 0, 0.25) 0px 5px 10px;
    }
    #about-card :first-child {
        margin-top: 0;
    }
    #about-card :last-child {
        margin-bottom: 0;
    }
</style>
