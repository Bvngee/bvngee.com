---
import PageContainer from "@components/PageContainer.astro";
import SocialLinkPreview from "@components/SocialLinkPreview.astro";
import BasePageLayout from "@layouts/BasePageLayout.astro";

import { Image } from "astro:assets";
import headshotImg from "@assets/1_small_cropped.jpg";
---

<BasePageLayout title="Home">
    <PageContainer>
        <!-- <h1 id="home-title">Jack Nystrom</h1> -->
        <div id="bio-headshot-container">
            <Image
                id="headshot"
                src={headshotImg}
                layout="full-width"
                alt="Jack Nystrom"
            />
            <div class="box" id="bio">
                <div id="bio-header">
                    <h1 style="margin: 0;">Jack Nystrom</h1>
                    <div id="socials">
                        <!-- use http://www.google.com/s2/favicons?domain=www.example.com if the default doesn't work, like with Discord -->
                        <SocialLinkPreview
                            title="GitHub"
                            href="https://www.github.com/Bvngee/"
                            favicon="https://www.github.com/favicon.ico"
                        />
                        <SocialLinkPreview
                            title="LinkedIn"
                            href="https://www.linkedin.com/in/jack-nystrom-3a7128311/"
                            favicon="https://static.licdn.com/aero-v1/sc/h/akt4ae504epesldzj74dzred8"
                        />
                        <SocialLinkPreview
                            title="Email"
                            href="mailto:nystromjp@gmail.com"
                            favicon="https://ssl.gstatic.com/ui/v1/icons/mail/rfr/gmail.ico"
                        />
                        <!-- <SocialLinkPreview -->
                        <!--     title="Reddit" -->
                        <!--     href="https://www.reddit.com/u/BvngeeCord/" -->
                        <!--     favicon="https://www.reddit.com/favicon.ico" -->
                        <!-- /> -->
                        <!-- <SocialLinkPreview -->
                        <!--     title="YouTube" -->
                        <!--     href="https://www.youtube.com/@Bvngee/" -->
                        <!--     favicon="https://www.youtube.com/favicon.ico" -->
                        <!-- /> -->
                        <!-- <SocialLinkPreview -->
                        <!--     title="Discord" -->
                        <!--     href="https://www.discordapp.com/users/484519672235163648" -->
                        <!--     favicon="https://www.google.com/s2/favicons?domain=www.discord.com" -->
                        <!-- /> -->
                    </div>
                </div>

                <p>
                    I'm a third-year CS/EE student at UC Santa Cruz, and the
                    Electrical Captain of <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://formulaslug.com/">Formula Slug</a
                    >.
                </p>
                <p>
                    I'm interested in tons of things but especially systems
                    programming and electronics. I care a lot about sustainable,
                    reliable, and valuable engineering.
                </p>

                <p>I go by bvngee on the internet.</p>
            </div>
        </div>
        <div class="box">
            <h2>About</h2>

            <p>
                Check out my various
                <a
                    href="/projects"
                    style="color: unset; text-decoration-color: var(--green);"
                    >projects</a
                >,
                <a
                    href="/writing"
                    style="color: unset; text-decoration-color: var(--blue);"
                    >writing</a
                >, and my
                <a
                    href="/resume"
                    style="color: unset; text-decoration-color: var(--purple);"
                    >resume/experience</a
                >!
            </p>

            <hr style="color: var(--gray1);" />

            A bunch of things in no particular order:
            <ul>
                <li>
                    I spend most of my time in the basements of Baskin
                    Engineering, working on an EV racecar
                </li>
                <li>
                    Passionate about high quality software engineering and
                    electronics, will talk for hours (be a nerd about something,
                    don't be boring!)
                </li>
                <li>
                    Mountain biker, but mostly as a social activity (I'm still
                    pretty mediocre)
                </li>
                <li>You won't find me coding in anything other than Neovim</li>
                <li>
                    Big fan of compiled programming languages that still expose
                    the details without compromising abstractions and safety.
                    Hopeful that Zig's new IO interface and the colorless-async
                    dream will have useful event-loop applications in embedded
                    programming
                </li>
                <li>
                    I use NixOS not because it saves me time in the long run but
                    because I absolutely love getting to control and understand
                    the pieces of my OS and the reproducibility of everything
                    down to specific program build flags and kernel parameters.
                    And because having isolated tooling is awesome
                </li>
                <li>
                    I believe in cities designed around pedestrians and bikes
                    over 50mph expressways and 8ft tall lifted trucks. E-biking
                    is my favorite part of the day, give it a try! People would
                    be healthier and happier.
                </li>
                <li>
                    I am strongly against AI agents. LLMs are a super useful
                    tool, but the way Big Tech is obsessed with AI and with
                    replacing human labor is nothing short of awful. Largely, AI
                    is in direct opposition with everything we should be
                    fighting for. Allow me to explain.
                    <ul>
                        <li>
                            The code that AI produces is mostly unuseable and/or
                            unmaintainable without skilled human review and
                            manual cleanup. In the hands of the right person
                            this can produce a viable output, but in most real
                            world cases the output of this AI-centric workflow
                            is a product with strictly worse quality and poorer
                            maintainability than the same product if it had been
                            made purely by humans. In a world where software
                            quality is essential to the everyday lives and
                            safety of billions of people, and where software is
                            already so frustratingly low-quality in so many
                            cases, I am very concerned by the direction we're
                            headed. Of course, CEOs and investors love anything
                            that promises a faster product to market. But the
                            world needs us to focus on quality, not getting out
                            the door faster.
                        </li>
                        <li>
                            Using an AI agent is outsourcing your intelligence
                            to a tool owned by one of ~3 billionares. We
                            sacrifice our agency and critical thinking in the
                            name of productivity, and hand over the intellectual
                            ownership of our product to a tool run by our
                            greatest enemies. We introduce a link in the chain
                            of information flow with the ability to wholely
                            manipulate it in whichever way they want, invisibly
                            to the user. Furthermore, the sacrifice of our
                            learning to artificial intelligence increases our
                            dependence on it, attaching a subscription fee to
                            the very basis of producing work. Who does this
                            "productivity" really benefit? Hint: it's not us.
                            (Meanwhile, Nvidia continues to gladly sell the
                            shovels...)
                        </li>
                        <li>
                            I believe that the best way to make use of AI is as
                            a glorified conversational search engine to help you
                            learn about well-known topics. It has ingested
                            basically all of the publicly available human
                            knowledge at this point, and is extremely good at
                            articulating it for you. What you should NOT use it
                            for is: designing APIs and interfaces, deriving new
                            solutions to unsolved problems, designing your
                            product, and especially not autonomously coding
                            anything.
                        </li>
                    </ul>
                </li>
                <li>
                    I am very concerned about the state of US politics, our
                    dysfunctional government, the scale of corruption, the
                    political polarization, the inability to pursue any remotely
                    radical progressive change, the intentionally
                    sensationalistic media, the voter suppression, the
                    ever-increasing national debt and defense budget, the
                    administration full of guilty but unstoppable narcissists,
                    and the embarassment of a national leader
                </li>
                <li>Induction stoves are awesome</li>
                <li>
                    Huge fan of Jazz and harmony and think that things like <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://www.youtube.com/watch?v=VPLCk-FTVvw&pp=ygUYbW9vbiByaXZlciBqYWNvYiBjb2xsaWVy"
                        >this</a
                    > are peak music (give it a chance)
                </li>
            </ul>
        </div>
    </PageContainer>
</BasePageLayout>

<style>
    #home-title {
        margin: 0 10px 20px 10px;
        /* text-shadow: 2px 4px 9px rgba(0,0,0,0.4); */
    }
    .box {
        padding: 15px;
        border-radius: 10px;
        background-color: var(--bg2);
        box-shadow: rgba(0, 0, 0, 0.25) 0px 5px 10px;
        margin: 20px 0;
    }
    .box > h2 {
        margin: 0;
    }
    .box > :first-child {
        margin-top: 0;
    }
    .box > :last-child {
        margin-bottom: 0;
    }
    .box a {
        text-decoration-color: var(--blue);
        color: var(--blue);
    }
    #bio-headshot-container {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 20px;

        margin: 20px 0;
    }
    #bio-headshot-container .box#bio {
        flex: 3 1;
        margin: 0;
        min-width: 15em;
    }
    #bio-headshot-container #headshot {
        flex: 1 1;

        max-width: 100%;
        height: auto;
        min-width: 12em;

        box-shadow: rgba(0, 0, 0, 0.25) 0px 5px 10px;
        border-radius: 10px;
        filter: brightness(90%);
    }
    #bio-headshot-container #bio #bio-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5em 2em;
        margin-bottom: 1.4em;
    }
    #bio-headshot-container #bio #bio-header #socials {
        display: flex;
        flex-wrap: nowrap;
        justify-content: center;
        gap: 12px;
        margin-right: 4px;
    }
    ul {
        /* make bullets a little closer to left wall of box */
        padding-left: 2em;
    }
    li {
        /* add a little vertical space between bullets */
        margin: 0.5em 0;
    }
</style>
