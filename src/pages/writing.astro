---
import BasePageLayout from "@layouts/BasePageLayout.astro";
import ArticleContentContainer from "@components/ArticleContentContainer.astro";
import PageContainer from "@components/PageContainer.astro";

import { getCollection } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { render, type CollectionEntry } from "astro:content";

const articles = await getCollection("writing");

if (articles.length == 0) {
    throw new Error("No articles found!");
}

const sortedArticles = articles
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.publishedDate!.unix - a.data.publishedDate!.unix);

const articleContent = await Promise.all(
    sortedArticles.map((p) => render(p).then((p) => p.Content)),
);

const postsAndContent: [CollectionEntry<"writing">, AstroComponentFactory][] =
    sortedArticles.map((p, i) => [p, articleContent[i]]);

const lastUpdatedDate = sortedArticles[0].data.publishedDate;
---

<BasePageLayout title="Writing">
    <PageContainer>
        <div id="header">
            <h1 id="header-title">Writing</h1>
            <div id="header-latest-date">
                Latest: {lastUpdatedDate!.longFormat}
            </div>
        </div>
        {
            postsAndContent.map(([post, Content]) => (
                <div id="article-card">
                    <div id="article-card-label">
                        <h2 id="article-title">
                            <a href={post.id}>{post.data.title}</a>
                        </h2>
                        <h id="article-date">
                            {post.data.publishedDate!.longFormat}
                        </h>
                    </div>
                    <div id="article-content">
                        <ArticleContentContainer>
                            <Content />
                        </ArticleContentContainer>
                    </div>
                </div>
            ))
        }
    </PageContainer>
</BasePageLayout>
<style>
    #header {
        padding: 0 10px;
        display: flex;
        justify-content: space-between;
    }
    #header-latest-date {
        min-width: max-content;
        margin: 0 0 4px 20px;
        align-self: flex-end;
        color: var(--fg2);
        opacity: 80%;
    }
    #header-title {
        margin: 0;
    }
    #article-card {
        background-color: var(--bg2);
        border-radius: 10px;
        padding: 10px;
        margin: 20px 0px;
        box-shadow: rgba(0, 0, 0, 0.25) 0px 5px 10px;
        transition-property: transform;
        transition-duration: 0.25s;
    }
    #article-card:hover {
        transform: scale(1.016) translateZ(0);
        backface-visibility: hidden;
    }
    #article-card-label {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        padding-bottom: 2px;
    }
    #article-title {
        margin: -2px 0 0 2px;
        text-shadow: 2px 4px 7px rgba(0, 0, 0, 0.4);
        max-width: 75%;
    }
    #article-date {
        padding: 5px;
        font-size: 14px;
        color: var(--gray2);
    }
    #article-title > a:hover {
        color: var(--aqua);
    }
    #article-title > a {
        text-decoration: none;
        color: var(--blue);
    }
    #article-hrs {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
    #article-hrs * {
        width: 3%;
        margin: 0;
        height: 4px;
        color: var(--aqua);
        background-color: var(--aqua);
        border-radius: 2px;
    }
    #article-content {
        display: block;
        white-space: normal;
        overflow: hidden;
        text-overflow: clip;
        max-height: 210px;
        margin: 5px 5px 0 5px;

        -webkit-mask-image: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.01),
            rgba(0, 0, 0, 0.3),
            rgba(0, 0, 0, 0.45),
            rgba(0, 0, 0, 0.9)
        );
        mask-image: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.01),
            rgba(0, 0, 0, 0.3),
            rgba(0, 0, 0, 0.45),
            rgba(0, 0, 0, 0.85)
        );
    }
</style>
