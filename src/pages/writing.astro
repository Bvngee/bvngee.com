---
import BasePageLayout from "@layouts/BasePageLayout.astro";
import PageContainer from "@components/PageContainer.astro";

import { getCollection } from "astro:content";

const articles = await getCollection("writing");

if (articles.length == 0) {
    throw new Error("No articles found!");
}

const sortedArticles = articles
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.publishedDate!.unix - b.data.publishedDate!.unix)
    .reverse();

const months = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
];
const formatDate = (date: Date) => {
    if (!date) return null;

    const year = date.getFullYear();
    const month = months[date.getMonth()];
    // Pad day with a leading zero if it is a single digit
    const day = String(date.getDate()).padStart(2, "0");

    return `${year} ${month} ${day}`;
};

// Old "preview" style:
// const articleContent = await Promise.all(
//     sortedArticles.map((p) => render(p).then((p) => p.Content)),
// );
//
// const postsAndContent: [CollectionEntry<"writing">, AstroComponentFactory][] =
//     sortedArticles.map((p, i) => [p, articleContent[i]]);

const lastUpdatedDate = sortedArticles[0].data.publishedDate;
---

<BasePageLayout title="Writing">
    <PageContainer>
        <div class="box">
            <h4 id="header-latest-date">
                Latest: {lastUpdatedDate!.longFormat}
            </h4>
            <div id="articles-list">{
                sortedArticles.map((post, i) => {
                    if (!post.data.publishedDate) return null;
                    const nextPost = sortedArticles[i - 1];
                    const addMargin =
                        (nextPost?.data.publishedDate?.dateObject.getFullYear() ??
                            0) >
                        post.data.publishedDate.dateObject.getFullYear();
                    return (
                        
                            <p id="article-date" class={addMargin ? "add-margin" : null}>
                                {formatDate(post.data.publishedDate.dateObject)}
                            </p>
                            <p id="article-title" class={addMargin ? "add-margin" : null}>
                                <a href={"/writing/" + post.id}>{post.data.title}</a>
                            </p>
                        
                    );
                })
            }</div>
        </div>

        <!-- Old "preview" style: -->
        <!-- { -->
        <!--     postsAndContent.map(([post, Content]) => ( -->
        <!--         <div id="article-card"> -->
        <!--             <div id="article-card-label"> -->
        <!--                 <h2 id="article-title"> -->
        <!--                     <a href={post.id}>{post.data.title}</a> -->
        <!--                 </h2> -->
        <!--                 <h id="article-date"> -->
        <!--                     {post.data.publishedDate!.longFormat} -->
        <!--                 </h> -->
        <!--             </div> -->
        <!--             <div id="article-content"> -->
        <!--                 <ArticleContentContainer> -->
        <!--                     <Content /> -->
        <!--                 </ArticleContentContainer> -->
        <!--             </div> -->
        <!--         </div> -->
        <!--     )) -->
        <!-- } -->
    </PageContainer>
</BasePageLayout>
