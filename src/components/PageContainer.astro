---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    children: any; // enforce <slot> being filled
}

---

<Header />
<main id="page-container">
    <slot />
    <Footer />
</main>
<style>
    #page-container {
        padding: 1.5rem 0.5rem;
        padding-bottom: 5rem;
        width: min(1000px, max(100%, 300px) - 1rem);
        margin-inline: auto;
    }
</style>
