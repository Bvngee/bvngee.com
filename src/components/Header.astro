---

enum Page {
    Home,
    About,
    Writing,
    Unknown,
}

const routeToPage: Record<string, Page> = {
    "": Page.Home,
    "about": Page.About,
    "writing": Page.Writing
};

let selectedPage = routeToPage[Astro.routePattern.split('/')[1]];
---

<!-- prettier-ignore -->
<nav id="nav-links">
    <div id="left"></div>

    <div id="center">
        <a 
            id="home" 
            class={selectedPage==Page.Home ? "selected" : ""} 
            href="/"
        >
            <span class="icon" id="home-logo"> </span>Home
        </a>
        <a 
            id="about"
            class={selectedPage==Page.About ? "selected" : ""}
            href="/about/"
        >
            <span class="icon" id="about-logo"> </span>About
        </a>
        <a
            id="writing"
            class={selectedPage==Page.Writing ? "selected" : ""}
            href="/writing/"
        >
            <span class="icon" id="writing-logo">󱀂 </span>Writing
        </a>
    </div>

    <div id="right"></div>
</nav>

<style>
    #nav-links {
        /* height: 50px; */
        /* This is kind of a hack; when the screen width is very small,
         * the width of the page-container becomes larger than the body,
         * but the nav is by default restricted to the width of the body
         * so it looks bad. This says if overflowing, use min width as
         * defined in src/Components/PageContainer.astro */
        width: max(100%, 300px);

        padding: 10px 0;
        display: flex;
        align-items: center;
        column-gap: 10px;
        box-shadow: rgba(0, 0, 0, 0.15) 0px 5px 10px;
        background-color: var(--bg2);
        font-weight: 600;
    }
    #center {
        display: flex;
        width: min(80%, 330px);
        justify-content: space-between;
    }
    /* Currently unused; previously I had content on the right side, left here
     * in case I change my mind again */
    #left, #right {
        flex: 1;
    }
    a {
        padding: 4px 6px;
        text-align: center;
        line-height: 120%;
        font-size: 18px;
        text-decoration: none;
        /* transform: perspective(1px) translateZ(0); */
        box-shadow: 0 0 1px rgba(0, 0, 0, 0);
        position: relative;
        overflow: hidden;
        /* transition-duration: 0.1s; */
        /* transition-property: transform; */
    }
    a::after {
        content: "";
        opacity: 90%;
        position: absolute;
        /* z-index: -1; */
        left: 5px;
        right: 100%;
        bottom: 2px;
        height: 2px;
        border-radius: 2px;
        transition-property: right;
        transition-duration: 0.15s;
    }
    a.selected::after {
        right: 5px;
    }
    a:hover::after {
        right: 5px;
    }
    a#home::after {
        background-color: var(--green);
    }
    a#about::after {
        background-color: var(--orange);
    }
    a#writing::after {
        background-color: var(--blue);
    }
    #home-logo {
        color: var(--green);
    }
    #about-logo {
        color: var(--orange);
        padding-right: 2px;
        font-size: 16px;
    }
    #writing-logo {
        color: var(--blue);
    }
    .icon {
        font-family: "CaskaydiaCove Nerd Font";
    }
</style>
