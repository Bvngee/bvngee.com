---
enum Page {
    About,
    Projects,
    Writing,
    Resume,
    Unknown,
}

const routeToPage: Record<string, Page> = {
    "": Page.About,
    about: Page.About,
    projects: Page.Projects,
    writing: Page.Writing,
    resume: Page.Resume,
};

let selectedPage = routeToPage[Astro.routePattern.split("/")[1]];
---

<nav id="nav-links">
    <div id="left"></div>

    <div id="center">
        <a
            id="about"
            class={selectedPage == Page.About ? "selected" : ""}
            href="/">About</a
        >
        <a
            id="projects"
            class={selectedPage == Page.Projects ? "selected" : ""}
            href="/projects">Projects</a
        >
        <a
            id="writing"
            class={selectedPage == Page.Writing ? "selected" : ""}
            href="/writing">Writing</a
        >
        <a
            id="resume"
            class={selectedPage == Page.Resume ? "selected" : ""}
            href="/resume">Resume</a
        >
    </div>

    <div id="right"></div>
</nav>

<style>
    #nav-links {
        padding: 4px 0 6px 0;
        display: flex;
        align-items: center;
        box-shadow: rgba(0, 0, 0, 0.1) 0px 3px 5px;
        background-color: var(--bg2);
        font-weight: 500;
    }
    #center {
        display: flex;
        justify-content: space-between;
        /* width: min(80%, 330px); */
        gap: 2em;
    }
    /* Currently unused; previously I had content on the right side, left here
     * in case I change my mind again */
    #left,
    #right {
        flex: 1;
    }
    a {
        padding: 4px 6px;
        text-align: center;
        line-height: 120%;
        font-size: 1.1em;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }
    a::after {
        content: "";
        opacity: 90%;
        position: absolute;
        /* z-index: -1; */
        left: 5px;
        right: 100%;
        bottom: 3px;
        height: 2px;
        border-radius: 2px;
        transition-property: right;
        transition-duration: 0.15s;
    }
    a.selected::after,
    a:hover::after {
        right: 5px;
    }
    a#about::after {
        background-color: var(--orange);
    }
    a#projects::after {
        background-color: var(--green);
    }
    a#writing::after {
        background-color: var(--blue);
    }
    a#resume::after {
        background-color: var(--purple);
    }
</style>
